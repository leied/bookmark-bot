# Copy to `.dev.vars` for local development with `npm run dev`.
# Also read by `npm run register`.
# In production these are secrets: `wrangler secret put <NAME>`.
#
# All three come from https://discord.com/developers/applications
DISCORD_TOKEN="your-bot-token"
DISCORD_PUBLIC_KEY="your-application-public-key"
DISCORD_APPLICATION_ID="your-application-id"
